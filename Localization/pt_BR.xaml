<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCLocalAchievementsSyncMenu">Sincronizar Conquistas Locais</sys:String>
    <sys:String x:Key="LOCLocalAchievementsReadingData">Lendo dados locais: {0}...</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSyncProgress">Sincronizando conquistas locais...</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsRestartPrompt">Foram sincronizadas {0} conquistas locais!&#x0a;&#x0a;Como a interface visual das conquistas requer recarregamento, deseja reiniciar o Playnite agora para aplicar as mudanças visuais?</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSyncComplete">Steam Tools - Sincronização Concluída</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpToDate">Tudo atualizado! Nenhuma nova conquista local foi detectada.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSteamToolsTitle">Steam Tools</sys:String>
    <sys:String x:Key="LOCLocalAchievementsTrackerNotification">Steam Tools Tracker: {0} novas conquistas recuperadas para {1}!</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSyncAchievementsMenu">Sincronizar Conquistas</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSyncPlaytimeMenu">Sincronizar Horas</sys:String>
    <sys:String x:Key="LOCLocalAchievementsPlaytimeProgress">Sincronizando horas jogadas...</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsPlaytimeResult">Horas atualizadas pela Steam: {0}&#x0a;Ignorados (Playnite já tem tempo igual ou maior): {1}&#x0a;Sem horas na Steam: {2}</sys:String>
    <sys:String x:Key="LOCLocalAchievementsPlaytimeTitle">Local Achievements - Horas</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSettingsAutoStartup">Sincronizar conquistas automaticamente ao iniciar o Playnite</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsAutoPlaytime">Atualizar horas pela Steam automaticamente (jogos novos e ao iniciar)</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsAutoPlaytimeHint">Para jogos do Steam Tools / Lua Tools: se a Steam tiver mais horas que o Playnite, o Playnite passa a usar o valor da Steam. Se o Playnite tiver igual ou mais, nada muda.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsPlaytimeNotification">{0}: {1}h de tempo de jogo importadas da Steam.</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSettingsSubtitle">Extensão para o SuccessStory</sys:String>

    <sys:String x:Key="LOCLocalAchievementsDiagnosticMenu">Copiar Relatório de Diagnóstico</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsOpenLog">Abrir Pasta de Logs</sys:String>
    <sys:String x:Key="LOCLocalAchievementsDiagnosticProgress">Coletando dados de diagnóstico...</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsDiagnosticDone">Relatório de diagnóstico copiado para a área de transferência. Cole na sua issue do GitHub.&#x0a;&#x0a;{0}</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsSyncNothing">Nenhuma conquista foi atualizada.&#x0a;&#x0a;{0}&#x0a;&#x0a;Use Copiar Relatório de Diagnóstico e anexe na sua issue do GitHub.</sys:String>

    <sys:String x:Key="LOCLocalAchievementsUpdateTitle">Local Achievements - Atualização disponível</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsUpdatePrompt">Há uma nova versão disponível.&#x0a;&#x0a;Versão instalada: {0}&#x0a;Nova versão: {1}&#x0a;&#x0a;Novidades:&#x0a;{2}&#x0a;&#x0a;Atualizar agora?</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateNotification">Local Achievements {1} disponível (instalada: {0}). Clique para ver as novidades e atualizar.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateDownloading">Baixando e verificando a atualização...</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsUpdateDone">A versão {0} foi instalada e verificada.&#x0a;&#x0a;Reiniciar o Playnite agora para concluir a atualização?</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsUpdateFailed">Não foi possível instalar a atualização automaticamente. A sua versão atual foi mantida.&#x0a;&#x0a;Motivo: {0}&#x0a;&#x0a;Abrir a página do release para atualizar manualmente?</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateUpToDate">Você está usando a versão mais recente ({0}).</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateCheckFailed">Não foi possível verificar atualizações: {0}</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateGameRunning">Há um jogo em execução. Feche-o e tente de novo, para o Playnite poder reiniciar com segurança.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateDevMode">Esta cópia roda de uma pasta de desenvolvedor, então a atualização automática está desativada. Último release: {0}.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateNoNotes">(nenhuma descrição publicada)</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdated">O Local Achievements foi atualizado para a versão {0}.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsUpdateMode">Avisos de atualização</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsUpdateModeDialog">Perguntar com uma janela</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsUpdateModeNotification">Apenas mostrar uma notificação do Playnite</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsUpdateModeOff">Não verificar atualizações</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsCheckUpdates">Verificar atualizações agora</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSettingsAutoReapply">Restaurar as conquistas automaticamente quando o SuccessStory atualizar os dados dele</sys:String>
    <sys:String x:Key="LOCLocalAchievementsReappliedNotification">O SuccessStory atualizou os dados dele. Conquistas restauradas em: {0}</sys:String>

</ResourceDictionary>