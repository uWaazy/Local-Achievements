<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCLocalAchievementsSyncMenu">Sincronizar Conquistas Locais</sys:String>
    <sys:String x:Key="LOCLocalAchievementsReadingData">Lendo dados locais: {0}...</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSyncProgress">Sincronizando conquistas locais...</sys:String>
    <sys:String x:Key="LOCLocalAchievementsRestartPrompt">Foram sincronizadas {0} conquistas locais!&#x0a;&#x0a;Como a interface visual das conquistas requer recarregamento, deseja reiniciar o Playnite agora para aplicar as mudanças visuais?</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSyncComplete">Steam Tools - Sincronização Concluída</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpToDate">Tudo atualizado! Nenhuma nova conquista local foi detectada.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSteamToolsTitle">Steam Tools</sys:String>
    <sys:String x:Key="LOCLocalAchievementsTrackerNotification">Steam Tools Tracker: {0} novas conquistas recuperadas para {1}!</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSyncAchievementsMenu">Sincronizar Conquistas</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSyncPlaytimeMenu">Sincronizar Horas</sys:String>
    <sys:String x:Key="LOCLocalAchievementsPlaytimeProgress">Sincronizando horas jogadas...</sys:String>
    <sys:String x:Key="LOCLocalAchievementsPlaytimeResult">Horas atualizadas pela Steam: {0}&#x0a;Ignorados (Playnite já tem tempo igual ou maior): {1}&#x0a;Sem horas na Steam: {2}</sys:String>
    <sys:String x:Key="LOCLocalAchievementsPlaytimeTitle">Local Achievements - Horas</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSettingsAutoStartup">Sincronizar conquistas automaticamente ao iniciar o Playnite</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsAutoPlaytime">Atualizar horas pela Steam automaticamente (jogos novos e ao iniciar)</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsAutoPlaytimeHint">Para jogos do Steam Tools / Lua Tools: se a Steam tiver mais horas que o Playnite, o Playnite passa a usar o valor da Steam. Se o Playnite tiver igual ou mais, nada muda.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsPlaytimeNotification">{0}: {1}h de tempo de jogo importadas da Steam.</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSettingsSubtitle">Extensão para o SuccessStory</sys:String>

</ResourceDictionary>