<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCLocalAchievementsSyncMenu">Sync Local Achievements</sys:String>
    <sys:String x:Key="LOCLocalAchievementsReadingData">Reading local data: {0}...</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSyncProgress">Synchronizing local achievements...</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsRestartPrompt">{0} local achievements have been synchronized!&#x0a;&#x0a;Since the visual interface requires a reload, do you want to restart Playnite now to apply the changes?</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSyncComplete">Steam Tools - Sync Complete</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpToDate">Everything is up to date! No new local achievements detected.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSteamToolsTitle">Steam Tools</sys:String>
    <sys:String x:Key="LOCLocalAchievementsTrackerNotification">Steam Tools Tracker: {0} new achievements recovered for {1}!</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSyncAchievementsMenu">Sync Achievements</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSyncPlaytimeMenu">Sync Playtime</sys:String>
    <sys:String x:Key="LOCLocalAchievementsPlaytimeProgress">Syncing playtime...</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsPlaytimeResult">Playtime updated from Steam: {0}&#x0a;Skipped (Playnite already has equal or more time): {1}&#x0a;No Steam playtime found: {2}</sys:String>
    <sys:String x:Key="LOCLocalAchievementsPlaytimeTitle">Local Achievements - Playtime</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSettingsAutoStartup">Sync achievements automatically when Playnite starts</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsAutoPlaytime">Update playtime from Steam automatically (new games and startup)</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsAutoPlaytimeHint">For Steam Tools / Lua Tools games: if Steam has more playtime than Playnite, Playnite is updated to the Steam value. If Playnite has equal or more, nothing changes.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsPlaytimeNotification">{0}: {1}h of playtime imported from Steam.</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSettingsSubtitle">Extension for SuccessStory</sys:String>

    <sys:String x:Key="LOCLocalAchievementsDiagnosticMenu">Copy Diagnostic Report</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsOpenLog">Open Log Folder</sys:String>
    <sys:String x:Key="LOCLocalAchievementsDiagnosticProgress">Collecting diagnostic data...</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsDiagnosticDone">Diagnostic report copied to the clipboard. Paste it into your GitHub issue.&#x0a;&#x0a;{0}</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsSyncNothing">No achievements were updated.&#x0a;&#x0a;{0}&#x0a;&#x0a;Use Copy Diagnostic Report and attach it to your GitHub issue.</sys:String>

    <sys:String x:Key="LOCLocalAchievementsUpdateTitle">Local Achievements - Update available</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsUpdatePrompt">A new version is available.&#x0a;&#x0a;Installed version: {0}&#x0a;New version: {1}&#x0a;&#x0a;What's new:&#x0a;{2}&#x0a;&#x0a;Update now?</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateNotification">Local Achievements {1} is available (installed: {0}). Click to see what is new and update.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateDownloading">Downloading and verifying the update...</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsUpdateDone">Version {0} was installed and verified.&#x0a;&#x0a;Restart Playnite now to finish the update?</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsUpdateFailed">The update could not be installed automatically. Your current version was kept.&#x0a;&#x0a;Reason: {0}&#x0a;&#x0a;Open the release page to update manually?</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateUpToDate">You are using the latest version ({0}).</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateCheckFailed">Could not check for updates: {0}</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateGameRunning">A game is running. Close it and try again, so Playnite can restart safely.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateDevMode">This copy runs from a developer folder, so automatic updates are disabled. Latest release: {0}.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateNoNotes">(no description published)</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdated">Local Achievements was updated to version {0}.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsUpdateMode">Update notifications</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsUpdateModeDialog">Ask me with a window</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsUpdateModeNotification">Only show a Playnite notification</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsUpdateModeOff">Do not check for updates</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsCheckUpdates">Check for updates now</sys:String>

</ResourceDictionary>