<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCLocalAchievementsSyncMenu">Sincronizar Logros Locales</sys:String>
    <sys:String x:Key="LOCLocalAchievementsReadingData">Leyendo datos locales: {0}...</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSyncProgress">Sincronizando logros locales...</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsRestartPrompt">¡Se han sincronizado {0} logros locales!&#x0a;&#x0a;Dado que la interfaz visual requiere recargarse, ¿deseas reiniciar Playnite ahora para aplicar los cambios visuales?</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSyncComplete">Steam Tools - Sincronización Completada</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpToDate">¡Todo actualizado! No se han detectado nuevos logros locales.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSteamToolsTitle">Steam Tools</sys:String>
    <sys:String x:Key="LOCLocalAchievementsTrackerNotification">Steam Tools Tracker: ¡{0} nuevos logros recuperados para {1}!</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSyncAchievementsMenu">Sincronizar Logros</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSyncPlaytimeMenu">Sincronizar Horas</sys:String>
    <sys:String x:Key="LOCLocalAchievementsPlaytimeProgress">Sincronizando horas jugadas...</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsPlaytimeResult">Horas actualizadas desde Steam: {0}&#x0a;Omitidos (Playnite ya tiene igual o más tiempo): {1}&#x0a;Sin horas en Steam: {2}</sys:String>
    <sys:String x:Key="LOCLocalAchievementsPlaytimeTitle">Local Achievements - Horas</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSettingsAutoStartup">Sincronizar logros automáticamente al iniciar Playnite</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsAutoPlaytime">Actualizar horas desde Steam automáticamente (juegos nuevos y al iniciar)</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsAutoPlaytimeHint">Para juegos de Steam Tools / Lua Tools: si Steam tiene más horas que Playnite, Playnite pasa a usar el valor de Steam. Si Playnite tiene igual o más, no cambia nada.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsPlaytimeNotification">{0}: {1}h de tiempo de juego importadas de Steam.</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSettingsSubtitle">Extensión para SuccessStory</sys:String>

    <sys:String x:Key="LOCLocalAchievementsDiagnosticMenu">Copiar Informe de Diagnóstico</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsOpenLog">Abrir Carpeta de Registros</sys:String>
    <sys:String x:Key="LOCLocalAchievementsDiagnosticProgress">Recopilando datos de diagnóstico...</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsDiagnosticDone">Informe de diagnóstico copiado al portapapeles. Pégalo en tu issue de GitHub.&#x0a;&#x0a;{0}</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsSyncNothing">No se actualizó ningún logro.&#x0a;&#x0a;{0}&#x0a;&#x0a;Usa Copiar Informe de Diagnóstico y adjúntalo en tu issue de GitHub.</sys:String>

    <sys:String x:Key="LOCLocalAchievementsUpdateTitle">Local Achievements - Actualización disponible</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsUpdatePrompt">Hay una nueva versión disponible.&#x0a;&#x0a;Versión instalada: {0}&#x0a;Nueva versión: {1}&#x0a;&#x0a;Novedades:&#x0a;{2}&#x0a;&#x0a;¿Actualizar ahora?</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateNotification">Local Achievements {1} disponible (instalada: {0}). Haz clic para ver las novedades y actualizar.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateDownloading">Descargando y verificando la actualización...</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsUpdateDone">La versión {0} se instaló y se verificó.&#x0a;&#x0a;¿Reiniciar Playnite ahora para terminar la actualización?</sys:String>
    <sys:String xml:space="preserve" x:Key="LOCLocalAchievementsUpdateFailed">No se pudo instalar la actualización automáticamente. Se mantuvo tu versión actual.&#x0a;&#x0a;Motivo: {0}&#x0a;&#x0a;¿Abrir la página del release para actualizar manualmente?</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateUpToDate">Estás usando la última versión ({0}).</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateCheckFailed">No se pudo buscar actualizaciones: {0}</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateGameRunning">Hay un juego en ejecución. Ciérralo e inténtalo de nuevo, para que Playnite pueda reiniciarse con seguridad.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateDevMode">Esta copia se ejecuta desde una carpeta de desarrollador, por lo que la actualización automática está desactivada. Último release: {0}.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdateNoNotes">(sin descripción publicada)</sys:String>
    <sys:String x:Key="LOCLocalAchievementsUpdated">Local Achievements se actualizó a la versión {0}.</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsUpdateMode">Avisos de actualización</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsUpdateModeDialog">Preguntarme con una ventana</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsUpdateModeNotification">Solo mostrar una notificación de Playnite</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsUpdateModeOff">No buscar actualizaciones</sys:String>
    <sys:String x:Key="LOCLocalAchievementsSettingsCheckUpdates">Buscar actualizaciones ahora</sys:String>

    <sys:String x:Key="LOCLocalAchievementsSettingsAutoReapply">Restaurar los logros automáticamente cuando SuccessStory actualice sus datos</sys:String>
    <sys:String x:Key="LOCLocalAchievementsReappliedNotification">SuccessStory actualizó sus datos. Logros restaurados en: {0}</sys:String>

</ResourceDictionary>